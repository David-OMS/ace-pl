# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Every variable here is validated at startup by src/lib/env.ts.

# --- App ---
# Public URL of the app. Used for auth redirects and links in notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Supabase dashboard -> Project Settings -> API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy "service_role" key. Server only, bypasses RLS.
SUPABASE_SECRET_KEY=
# The "your-project-ref" part of the URL. Used to generate database types.
SUPABASE_PROJECT_REF=

# --- Google sign-in (local Supabase only) ---
# The Next app does not read these. Production Google is enabled in the Supabase dashboard.
# Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Push notifications (Web Push) ---
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as a mailto: link.
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduled jobs ---
# Random string that Vercel Cron sends so only it can trigger jobs (e.g. deadline reminders).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Error tracking (optional until launch) ---
NEXT_PUBLIC_SENTRY_DSN=
