# TypeScript

- Strict mode. No `any` (use `unknown` and narrow). No `!` non-null assertions outside tests.
- Explicit return types on exported functions.
- Prefer `type` over `interface`.
- Validate all external input with Zod at the boundary (forms, URL params, server action args).
- Database types come from `src/types/database.ts` (generated). Never hand-write table types.
- Naming: files `kebab-case`, components `PascalCase`, functions/vars `camelCase`,
  booleans as questions (`isPublished`, `hasCleanSheet`), true constants `SCREAMING_SNAKE_CASE`.

## Server actions return results, not exceptions

```ts
// Bad
export async function publishResult(id: string) {
  const { error } = await db.from("fixtures").update({ status: "completed" }).eq("id", id);
  if (error) throw error;
}

// Good
export async function publishResult(input: unknown): Promise<ActionResult<void>> {
  const parsed = publishResultSchema.safeParse(input);
  if (!parsed.success) return fail("invalid_input");
  if (!(await isAdmin())) return fail("forbidden");
  const { error } = await db.from("fixtures").update({ status: "completed" }).eq("id", parsed.data.fixtureId);
  if (error) {
    logger.error("publish_result_failed", { fixtureId: parsed.data.fixtureId, error });
    return fail("save_failed");
  }
  revalidateFixture(parsed.data.fixtureId);
  return ok(undefined);
}
```

- No `console.log`; use `src/lib/logger.ts`.
- Never swallow errors with an empty `catch`.
